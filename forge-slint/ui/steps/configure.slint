import { Palette, Sizes } from "../theme.slint";
import { ScrollView } from "std-widgets.slint";
import { TabRail } from "../components/tab_rail.slint";
import { TabIdentity } from "configure/tab_identity.slint";
import { TabAccess }   from "configure/tab_access.slint";
import { TabSystem }   from "configure/tab_system.slint";
import { TabServices } from "configure/tab_services.slint";
import { TabStorage }  from "configure/tab_storage.slint";

// ── Main configure step ──────────────────────────────────────────────────────

export component StepConfigure inherits Rectangle {
    // Source row (read-only display + distro picker)
    in property <string>  source-display;
    in property <string>  distro;
    in property <string>  selected-preset-name;
    in property <string>  distro-display;
    callback distro-changed(string);
    callback clear-source();

    // Machine Identity
    in-out property <string> hostname;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> password-confirm;
    in-out property <string> realname;
    in property <bool>       passwords-match: true;

    // Derived: real-time mismatch
    property <bool> pw-live-mismatch: password != "" && password-confirm != ""
                                       && password != password-confirm;

    // SSH
    in-out property <string> ssh-keys;
    in-out property <bool>   ssh-password-auth: false;
    in-out property <bool>   ssh-install-server: true;

    // Network
    in-out property <string> dns-servers;
    in-out property <string> ntp-servers;
    in-out property <string> static-ip;
    in-out property <string> gateway;
    in-out property <string> http-proxy;
    in-out property <string> https-proxy;
    in-out property <string> no-proxy;

    // System
    in-out property <string> timezone;
    in-out property <string> locale;
    in-out property <string> keyboard-layout;
    in-out property <string> storage-layout;
    in-out property <string> apt-mirror;

    // Packages
    in-out property <string> packages;
    in-out property <string> apt-repos;
    in-out property <string> dnf-repos;
    in-out property <string> run-commands;
    in-out property <string> late-commands;

    // Firewall
    in-out property <bool>   firewall-enabled: false;
    in-out property <string> firewall-policy;
    in-out property <string> allow-ports;
    in-out property <string> deny-ports;

    // User & Access
    in-out property <string> user-groups;
    in-out property <string> user-shell;
    in-out property <bool>   sudo-nopasswd: false;

    // Services
    in-out property <string> enable-services;
    in-out property <string> disable-services;

    // Containers
    in-out property <bool>   docker: false;
    in-out property <bool>   podman: false;
    in-out property <string> docker-users;

    // Storage
    in-out property <string> swap-size-mb;
    in-out property <bool>   encrypt: false;
    in-out property <string> encrypt-passphrase;
    in-out property <string> mounts;

    // GRUB
    in-out property <string> grub-timeout;
    in-out property <string> grub-cmdline;
    in-out property <string> grub-default;

    // Sysctl
    in-out property <string> sysctl-pairs;

    // Distro-specific repos
    in-out property <string> dnf-mirror;
    in-out property <string> pacman-repos;
    in-out property <string> pacman-mirror;

    // Extra access
    in-out property <string> sudo-commands;

    // Swap tuning
    in-out property <string> swap-filename;
    in-out property <string> swap-swappiness;

    // Desktop
    in-out property <string> wallpaper-path;

    // Output
    in-out property <string> output-dir;
    in-out property <string> out-name;
    in-out property <string> output-label;
    in-out property <string> expected-sha256;

    // Unattended
    in-out property <bool>   no-user-interaction: false;

    // Active tab
    in-out property <int> active-tab: 0;

    // Defaults
    in property <string>  defaults-summary;
    callback apply-defaults();
    callback reset-defaults();
    callback field-edited(string);
    callback username-changed(string);
    callback docker-changed();

    in property <bool>    running: false;
    in property <bool>    can-continue: false;
    callback browse-output-dir();
    callback configure-continue();
    callback back-clicked();

    background: Palette.bg;

    VerticalLayout {
        spacing: 0px;

        // ── Summary bar (under PageHeader) ───────────────────────────────
        // The PageHeader in app.slint already shows the step title + subtitle
        // and houses the doctor + cancel actions. This section is a slim
        // context summary: source ISO + apply-defaults + back-to-source.
        VerticalLayout {
            padding-left: 32px;
            padding-right: 32px;
            padding-top: 16px;
            padding-bottom: 12px;
            spacing: 10px;
            alignment: start;

            // Back-to-source row (vector chevron icon, secondary action)
            HorizontalLayout {
                spacing: 12px;
                alignment: space-between;

                // Empty left slot — title is in PageHeader now
                Rectangle { horizontal-stretch: 1; }

                Rectangle {
                    width: 124px;
                    height: 30px;
                    border-radius: Sizes.radius-sm;
                    background: cfg-back-ta.has-hover ? Palette.active : Palette.elevated;
                    border-width: 1px;
                    border-color: Palette.border;
                    animate background { duration: 100ms; }
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: center;
                        Image {
                            source: @image-url("../icons/chevron-left.svg");
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                            colorize: Palette.text-secondary;
                            image-fit: contain;
                        }
                        Text {
                            text: "Change ISO";
                            font-size: Sizes.font-xs;
                            font-weight: 500;
                            color: Palette.text;
                            vertical-alignment: center;
                        }
                    }
                    cfg-back-ta := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => { back-clicked(); }
                    }
                }
            }

            // Source display
            Rectangle {
                height: selected-preset-name != "" ? 62px : 44px;
                border-radius: Sizes.radius-sm;
                background: Palette.accent-soft;
                border-width: 1px;
                border-color: Palette.accent-soft-border;
                VerticalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    padding-top: 10px;
                    padding-bottom: 10px;
                    spacing: 6px;
                    alignment: start;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Image {
                            source: @image-url("../icons/disc.svg");
                            width: 16px;
                            height: 16px;
                            y: (parent.height - self.height) / 2;
                            colorize: Palette.accent;
                            image-fit: contain;
                        }
                        Text {
                            text: source-display;
                            font-size: Sizes.font-sm;
                            color: Palette.text;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                    }
                    if selected-preset-name != "": Text {
                        text: "Preset: " + selected-preset-name + "  \u{00B7}  " + distro-display;
                        font-size: Sizes.font-xs;
                        color: Palette.muted;
                        overflow: elide;
                    }
                }
            }

            // Defaults banner
            if defaults-summary != "": Rectangle {
                height: 44px;
                border-radius: Sizes.radius-sm;
                background: Palette.green-soft;
                border-width: 1px;
                border-color: Palette.green-soft-border;
                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 8px;
                    spacing: 10px;
                    alignment: space-between;
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: start;
                        Image {
                            source: @image-url("../icons/settings.svg");
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                            colorize: Palette.green;
                            image-fit: contain;
                        }
                        Text {
                            text: "Defaults: " + defaults-summary;
                            font-size: Sizes.font-xs;
                            color: Palette.muted;
                            vertical-alignment: center;
                        }
                    }
                    HorizontalLayout {
                        spacing: 6px;
                        alignment: end;
                        Rectangle {
                            width: 116px;
                            height: 28px;
                            border-radius: Sizes.radius-sm;
                            background: apply-ta.has-hover && !running
                                ? Palette.green-soft
                                : Palette.green-soft;
                            border-width: 1px;
                            border-color: Palette.green-soft-border;
                            animate background { duration: 100ms; }
                            Text {
                                text: "Apply Defaults";
                                font-size: Sizes.font-xs;
                                font-weight: 600;
                                color: Palette.green;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            apply-ta := TouchArea {
                                enabled: !running;
                                mouse-cursor: running ? MouseCursor.default : MouseCursor.pointer;
                                clicked => { apply-defaults(); }
                            }
                        }
                        Rectangle {
                            width: 72px;
                            height: 28px;
                            border-radius: Sizes.radius-sm;
                            background: reset-ta.has-hover && !running ? Palette.active : Palette.elevated;
                            border-width: 1px;
                            border-color: Palette.border;
                            animate background { duration: 100ms; }
                            Text {
                                text: "Reset";
                                font-size: Sizes.font-xs;
                                color: Palette.muted;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            reset-ta := TouchArea {
                                enabled: !running;
                                mouse-cursor: running ? MouseCursor.default : MouseCursor.pointer;
                                clicked => { reset-defaults(); }
                            }
                        }
                    }
                }
            }
        }

        // Separator below title area
        Rectangle {
            height: 1px;
            background: Palette.border;
            opacity: 0.5;
        }

        // ── TabRail + Content panel ──────────────────────────────────────
        HorizontalLayout {
            // Left: tab rail (fixed 200px)
            TabRail {
                active-index: active-tab;
                essentials-complete: hostname != "" && username != "" && output-dir != "" && out-name != "";
                tab-clicked(idx) => { active-tab = idx; }
            }

            // Right: content panel (fills remaining space)
            VerticalLayout {
                // Tab content with scroll
                ScrollView {
                    VerticalLayout {
                        padding-left: 32px;
                        padding-right: 32px;
                        padding-top: 24px;
                        padding-bottom: 24px;
                        spacing: 14px;
                        alignment: start;

                        // ── TAB 0: Identity & Output ────────────────────
                        if active-tab == 0: TabIdentity {
                            hostname <=> root.hostname;
                            username <=> root.username;
                            password <=> root.password;
                            password-confirm <=> root.password-confirm;
                            realname <=> root.realname;
                            passwords-match: root.passwords-match;
                            pw-live-mismatch: root.pw-live-mismatch;
                            output-dir <=> root.output-dir;
                            out-name <=> root.out-name;
                            output-label <=> root.output-label;
                            expected-sha256 <=> root.expected-sha256;
                            running: root.running;
                            username-changed(t) => { root.username-changed(t); }
                            browse-output-dir => { root.browse-output-dir(); }
                        }

                        // ── TAB 1: Access & Network ─────────────────────
                        if active-tab == 1: TabAccess {
                            ssh-keys <=> root.ssh-keys;
                            ssh-password-auth <=> root.ssh-password-auth;
                            ssh-install-server <=> root.ssh-install-server;
                            distro: root.distro;
                            user-groups <=> root.user-groups;
                            user-shell <=> root.user-shell;
                            sudo-nopasswd <=> root.sudo-nopasswd;
                            sudo-commands <=> root.sudo-commands;
                            dns-servers <=> root.dns-servers;
                            ntp-servers <=> root.ntp-servers;
                            static-ip <=> root.static-ip;
                            gateway <=> root.gateway;
                            http-proxy <=> root.http-proxy;
                            https-proxy <=> root.https-proxy;
                            no-proxy <=> root.no-proxy;
                            running: root.running;
                            field-edited(name) => { root.field-edited(name); }
                        }

                        // ── TAB 2: System & Packages ────────────────────
                        if active-tab == 2: TabSystem {
                            distro: root.distro;
                            timezone <=> root.timezone;
                            locale <=> root.locale;
                            keyboard-layout <=> root.keyboard-layout;
                            storage-layout <=> root.storage-layout;
                            apt-mirror <=> root.apt-mirror;
                            packages <=> root.packages;
                            apt-repos <=> root.apt-repos;
                            dnf-repos <=> root.dnf-repos;
                            dnf-mirror <=> root.dnf-mirror;
                            pacman-repos <=> root.pacman-repos;
                            pacman-mirror <=> root.pacman-mirror;
                            running: root.running;
                            field-edited(name) => { root.field-edited(name); }
                        }

                        // ── TAB 3: Services & Security ──────────────────
                        if active-tab == 3: TabServices {
                            enable-services <=> root.enable-services;
                            disable-services <=> root.disable-services;
                            docker <=> root.docker;
                            podman <=> root.podman;
                            docker-users <=> root.docker-users;
                            firewall-enabled <=> root.firewall-enabled;
                            firewall-policy <=> root.firewall-policy;
                            allow-ports <=> root.allow-ports;
                            deny-ports <=> root.deny-ports;
                            running: root.running;
                            field-edited(name) => { root.field-edited(name); }
                            docker-changed => { root.docker-changed(); }
                        }

                        // ── TAB 4: Storage & Advanced ───────────────────
                        if active-tab == 4: TabStorage {
                            swap-size-mb <=> root.swap-size-mb;
                            encrypt <=> root.encrypt;
                            encrypt-passphrase <=> root.encrypt-passphrase;
                            mounts <=> root.mounts;
                            swap-filename <=> root.swap-filename;
                            swap-swappiness <=> root.swap-swappiness;
                            grub-timeout <=> root.grub-timeout;
                            grub-cmdline <=> root.grub-cmdline;
                            grub-default <=> root.grub-default;
                            run-commands <=> root.run-commands;
                            late-commands <=> root.late-commands;
                            wallpaper-path <=> root.wallpaper-path;
                            sysctl-pairs <=> root.sysctl-pairs;
                            no-user-interaction <=> root.no-user-interaction;
                            running: root.running;
                        }
                    }
                }

                // ── Continue button (always visible at bottom) ───────────
                Rectangle {
                    height: 1px;
                    background: Palette.border;
                    opacity: 0.5;
                }
                HorizontalLayout {
                    padding-left: 32px;
                    padding-top: 12px;
                    padding-bottom: 16px;
                    alignment: start;
                    Rectangle {
                        width: 280px;
                        height: 42px;
                        border-radius: Sizes.radius-sm;
                        property <bool> btn-active: can-continue && !pw-live-mismatch;
                        background: btn-active
                            ? (cfg-fwd-ta.has-hover ? Palette.accent-hover : Palette.accent)
                            : Palette.elevated;
                        opacity: btn-active ? 1.0 : 0.6;
                        animate background { duration: 120ms; }
                        animate opacity  { duration: 180ms; }
                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 8px;
                            alignment: center;
                            Text {
                                text: "Continue to Build Summary";
                                font-size: Sizes.font-sm;
                                font-weight: 600;
                                color: btn-active ? Palette.on-accent : Palette.subtle;
                                vertical-alignment: center;
                            }
                            Image {
                                source: @image-url("../icons/chevron-right.svg");
                                width: 12px;
                                height: 12px;
                                y: (parent.height - self.height) / 2;
                                colorize: btn-active ? Palette.on-accent : Palette.subtle;
                                image-fit: contain;
                            }
                        }
                        cfg-fwd-ta := TouchArea {
                            enabled: btn-active && !running;
                            mouse-cursor: btn-active && !running ? MouseCursor.pointer : MouseCursor.default;
                            clicked => { configure-continue(); }
                        }
                    }
                }
            }
        }
    }
}
