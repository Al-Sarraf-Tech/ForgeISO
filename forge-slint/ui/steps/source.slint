import { Palette, Sizes } from "../theme.slint";
import { FButton, FImageIconButton, FBadge, FDivider, FSectionLabel, FFieldHelp } from "../components/design_system.slint";
import { ScrollView } from "std-widgets.slint";
import { AppState } from "../globals/app_state.slint";

export struct PresetCard {
    id: string,
    emoji: string,
    name: string,
    desc: string,
    // True when this preset is recommended by the currently-selected
    // configuration profile (per ProfileKind::recommended_for). Drives
    // the corner star badge on DistroCard. The Rust side recomputes the
    // model when the active profile changes.
    recommended: bool,
}

// One entry in the configuration-profile chip row. `id` matches the engine
// ProfileKind serialization ("server-default" | "server-hardened" |
// "desktop-developer" | "kiosk" | "minimal-cloud"). `description` shows
// below the chip row when this chip is the active selection.
export struct ProfileChip {
    id: string,
    label: string,
    description: string,
}

// ── ProfileChipBtn ──────────────────────────────────────────────────────────
// One pill-shaped chip in the configuration-profile selector row. Selected
// state uses the accent-soft palette tokens (WCAG-AA in both themes via the
// same palette path that other accent pills use).
component ProfileChipBtn inherits Rectangle {
    in property <ProfileChip> chip;
    in property <bool>        selected: false;
    in property <bool>        running: false;
    callback clicked();

    height: 30px;
    border-radius: 15px;
    background: selected ? Palette.accent-soft
              : ta.has-hover && !running ? Palette.active
              : Palette.elevated;
    border-width: 1px;
    border-color: selected ? Palette.accent-soft-border
               : ta.has-hover && !running ? Palette.border-focus
               : Palette.border;
    opacity: running ? 0.55 : 1.0;
    animate background { duration: 120ms; }
    animate border-color { duration: 120ms; }
    animate opacity { duration: 120ms; }

    HorizontalLayout {
        padding-left: Sizes.space-3;
        padding-right: Sizes.space-3;
        alignment: center;
        Text {
            text: chip.label;
            font-size: Sizes.font-2xs;
            font-weight: 700;
            // accent text on accent-soft chip; muted-but-AA otherwise
            color: selected ? Palette.accent : Palette.text-secondary;
            letter-spacing: 0.6px;
            vertical-alignment: center;
            animate color { duration: 120ms; }
        }
    }

    ta := TouchArea {
        enabled: !running;
        mouse-cursor: running ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
    }
}

// Brand-colored monogram circle per distro family. Uses card.id prefix to
// pick the brand color so the swatch is consistent across themes (brand
// identity is the same in dark + light). Falls back to neutral on unknown.
component DistroCard inherits Rectangle {
    in property <PresetCard> card;
    in property <bool>       selected: false;
    in property <bool>       running: false;
    callback clicked();

    width: 180px;
    height: 110px;
    border-radius: Sizes.radius-md;
    background: selected ? Palette.green-soft
              : hovered && !running ? Palette.active
              : Palette.elevated;
    border-width: selected ? 1.5px : 1px;
    border-color: selected ? Palette.green-soft-border
               : hovered && !running ? Palette.border-focus
               : Palette.border-subtle;
    opacity: running ? 0.6 : 1.0;
    animate background { duration: 150ms; }
    animate border-color { duration: 150ms; }
    animate opacity { duration: 150ms; }

    property <bool> hovered: touch.has-hover;

    // Brand color per distro family. These are the distros' actual brand
    // colors (Ubuntu orange, Fedora blue, Arch blue, Mint green, Rocky
    // green, AlmaLinux teal, CentOS purple, Debian red). Brand identity
    // doesn't shift between dark/light themes.
    property <color> brand: card.id == "ubuntu-server-lts" || card.id == "ubuntu-server-jammy" ? #E95420
                          : card.id == "fedora-server" ? #294172
                          : card.id == "arch-linux" ? #1793D1
                          : card.id == "linux-mint-cinnamon" ? #86BE43
                          : card.id == "rocky-linux" ? #10B981
                          : card.id == "almalinux" ? #0FB37D
                          : card.id == "centos-stream" ? #932279
                          : Palette.muted;

    // First letter of distro name (after stripping "Linux " prefix). Single
    // glyph, white on brand. The actual brand wordmark is the card.name text
    // below — this is a recognizable shorthand, not a logo claim.
    property <string> mono: card.id == "ubuntu-server-lts" || card.id == "ubuntu-server-jammy" ? "U"
                          : card.id == "fedora-server" ? "F"
                          : card.id == "arch-linux" ? "A"
                          : card.id == "linux-mint-cinnamon" ? "M"
                          : card.id == "rocky-linux" ? "R"
                          : card.id == "almalinux" ? "A"
                          : card.id == "centos-stream" ? "C"
                          : "L";

    VerticalLayout {
        alignment: center;
        spacing: Sizes.space-2;
        padding-left: Sizes.space-4;
        padding-right: Sizes.space-4;
        padding-top: Sizes.space-3;
        padding-bottom: Sizes.space-3;

        // Brand monogram circle
        Rectangle {
            width: 32px;
            height: 32px;
            border-radius: 16px;
            background: brand;
            horizontal-stretch: 0;
            Text {
                text: mono;
                font-size: 16px;
                font-weight: 800;
                color: #ffffff;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }
        Text {
            text: card.name;
            font-size: Sizes.font-md;
            font-weight: 600;
            color: selected ? Palette.green : Palette.text;
            horizontal-alignment: center;
            animate color { duration: 150ms; }
        }
        Text {
            text: card.desc;
            font-size: Sizes.font-xs;
            color: Palette.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }

    touch := TouchArea {
        enabled: !running;
        mouse-cursor: running ? MouseCursor.default : MouseCursor.pointer;
        clicked => { root.clicked(); }
    }

    // ── Recommended badge ────────────────────────────────────────────────
    // Top-right corner pill. Only renders when the active profile lists
    // this preset in its recommended set. Uses Palette.amber-soft tokens
    // so contrast stays AA in both dark + light themes.
    if card.recommended: Rectangle {
        x: parent.width - self.width - 6px;
        y: 6px;
        width: 116px;
        height: 18px;
        border-radius: 9px;
        background: Palette.amber-soft;
        border-width: 1px;
        border-color: Palette.amber-soft-border;
        HorizontalLayout {
            spacing: 3px;
            padding-left: Sizes.space-2;
            padding-right: Sizes.space-2;
            alignment: center;
            // Star glyph (U+2605). Renders crisp at 10px on every backend.
            Text {
                text: "\u{2605}";
                font-size: 10px;
                color: Palette.amber;
                vertical-alignment: center;
            }
            Text {
                text: "RECOMMENDED";
                font-size: Sizes.font-2xs;
                font-weight: 700;
                color: Palette.amber;
                letter-spacing: 0.6px;
                vertical-alignment: center;
            }
        }
    }
}

export component StepSource inherits Rectangle {
    in property <[PresetCard]>  presets-row1;
    in property <[PresetCard]>  presets-row2;
    // Configuration-profile chip row + currently-selected id. List supplied
    // by Rust (forge-slint::config::make_profile_chips) so the canonical
    // labels and descriptions live next to the engine ProfileKind catalog.
    in property <[ProfileChip]> profile-chips;
    in property <string>        selected-profile;
    in property <string>        source-path;
    in property <string>        selected-preset;
    in property <string>        detected-distro;
    in property <bool>          running: false;
    in property <bool>          can-continue: false;
    callback preset-clicked(string);
    callback profile-clicked(string);
    callback browse-clicked();
    callback source-changed(string);
    callback continue-clicked();
    callback clear-clicked();

    background: Palette.bg;

    ScrollView {
        VerticalLayout {
            padding: Sizes.space-10;
            spacing: Sizes.space-8;
            alignment: start;

            // -- Title -------------------------------------------------------
            VerticalLayout {
                spacing: Sizes.space-2;
                Text {
                    text: "Build Your ISO";
                    font-size: Sizes.font-3xl;
                    font-weight: 700;
                    color: Palette.text;
                    letter-spacing: -0.5px;
                }
                Text {
                    text: "Inject unattended install config into any Linux ISO \u{2014} Ubuntu, Fedora, Arch, Mint and more.";
                    font-size: Sizes.font-md;
                    color: Palette.muted;
                }
            }

            // -- Configuration profile selector ------------------------------
            // Five segmented chips, default ServerDefault. Description below
            // updates when the selection changes. The selected profile drives
            // the recommended-badge on the distro grid (next section) and is
            // applied on top of distro defaults when the user enters Step 2.
            VerticalLayout {
                spacing: Sizes.space-2;
                FSectionLabel {
                    text: "CONFIGURATION PROFILE";
                    letter-spacing: 1.5px;
                }

                HorizontalLayout {
                    spacing: Sizes.space-2;
                    alignment: start;
                    for chip in profile-chips: ProfileChipBtn {
                        chip: chip;
                        selected: selected-profile == chip.id;
                        running: running;
                        clicked => { profile-clicked(chip.id); }
                    }
                }

                // Active-profile description. Resolves the matching chip's
                // description; empty string when no chip matches (defensive).
                FFieldHelp {
                    text: profile-chips.length > 0
                        ? (selected-profile == profile-chips[0].id ? profile-chips[0].description
                          : profile-chips.length > 1 && selected-profile == profile-chips[1].id ? profile-chips[1].description
                          : profile-chips.length > 2 && selected-profile == profile-chips[2].id ? profile-chips[2].description
                          : profile-chips.length > 3 && selected-profile == profile-chips[3].id ? profile-chips[3].description
                          : profile-chips.length > 4 && selected-profile == profile-chips[4].id ? profile-chips[4].description
                          : "")
                        : "";
                }
            }

            // -- Distro grid -------------------------------------------------
            VerticalLayout {
                spacing: Sizes.space-3;
                FSectionLabel {
                    text: "POPULAR DISTRIBUTIONS";
                    letter-spacing: 1.5px;
                }

                // Row 1
                HorizontalLayout {
                    spacing: Sizes.space-3;
                    alignment: center;
                    for card in presets-row1: DistroCard {
                        card: card;
                        selected: selected-preset == card.id;
                        running: running;
                        clicked => { preset-clicked(card.id); }
                    }
                }

                // Row 2 (only rendered if non-empty)
                if presets-row2.length > 0: HorizontalLayout {
                    spacing: Sizes.space-3;
                    alignment: center;
                    for card in presets-row2: DistroCard {
                        card: card;
                        selected: selected-preset == card.id;
                        running: running;
                        clicked => { preset-clicked(card.id); }
                    }
                }
            }

            // -- Manual path entry -------------------------------------------
            VerticalLayout {
                spacing: Sizes.space-3;
                FDivider {
                    label: "or enter a path / URL directly";
                }

                HorizontalLayout {
                    spacing: Sizes.space-2;
                    alignment: start;

                    // Path input
                    Rectangle {
                        height: 42px;
                        border-radius: Sizes.radius-sm;
                        background: Palette.bg;
                        border-width: 1px;
                        border-color: path-input.has-focus ? Palette.accent : Palette.border;
                        animate border-color { duration: 150ms; }
                        if source-path == "" && !path-input.has-focus: Text {
                            x: Sizes.space-3;
                            y: 0;
                            width: parent.width - Sizes.space-6;
                            height: parent.height;
                            text: "/path/to/ubuntu.iso  or  https://releases.ubuntu.com/\u{2026}";
                            font-size: Sizes.font-sm;
                            color: Palette.subtle;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        path-input := TextInput {
                            x: Sizes.space-3;
                            y: (parent.height - self.preferred-height) / 2;
                            width: parent.width - Sizes.space-6;
                            text: source-path;
                            font-size: Sizes.font-sm;
                            color: Palette.text;
                            selection-background-color: Palette.accent;
                            selection-foreground-color: Palette.on-accent;
                            single-line: true;
                            enabled: !running;
                            edited => { source-changed(path-input.text); }
                            accepted => {
                                if (can-continue && !running) { continue-clicked(); }
                            }
                        }
                    }

                    // Browse button
                    FButton {
                        label: "Browse\u{2026}";
                        variant: "secondary";
                        enabled: !running;
                        width: 90px;
                        height: 42px;
                        clicked => { browse-clicked(); }
                    }

                    // Clear button
                    if source-path != "": FImageIconButton {
                        icon-source: @image-url("../icons/x.svg");
                        variant: "destructive";
                        enabled: !running;
                        width: 42px;
                        height: 42px;
                        clicked => { clear-clicked(); }
                    }
                }

                // Detection loading indicator
                if AppState.detect-running && detected-distro == "": HorizontalLayout {
                    alignment: start;
                    spacing: Sizes.space-2;
                    Text {
                        text: "Detecting distro\u{2026}";
                        font-size: Sizes.font-xs;
                        color: Palette.muted;
                        vertical-alignment: center;
                    }
                    // Indeterminate dot animation
                    Rectangle {
                        width: 40px;
                        height: 4px;
                        border-radius: 2px;
                        background: Palette.border-subtle;
                        clip: true;
                        y: (parent.height - self.height) / 2;
                        property <float> sweep: 0.0;
                        init => { sweep = 1.0; }
                        animate sweep { duration: 1200ms; easing: ease-in-out; iteration-count: -1; }
                        Rectangle {
                            x: (parent.width + 16px) * sweep - 16px;
                            width: 16px;
                            height: parent.height;
                            border-radius: 2px;
                            background: Palette.accent;
                        }
                    }
                }

                // Detected distro badge
                if detected-distro != "": HorizontalLayout {
                    alignment: start;
                    spacing: Sizes.space-2;
                    Image {
                        source: @image-url("../icons/check.svg");
                        width: 14px;
                        height: 14px;
                        y: (parent.height - self.height) / 2;
                        colorize: Palette.green;
                        image-fit: contain;
                    }
                    FBadge {
                        text: "Detected: " + detected-distro;
                        variant: "success";
                        height: 26px;
                        border-radius: 13px;
                    }
                }
            }

            // -- Continue button ---------------------------------------------
            HorizontalLayout {
                alignment: start;
                FButton {
                    label: "Continue to Configure Installer \u{2192}";
                    variant: "primary";
                    enabled: can-continue && !running;
                    width: 300px;
                    height: 46px;
                    clicked => { continue-clicked(); }
                }
            }
        }
    }
}
