import { Palette, Sizes } from "../theme.slint";

// ── FIcon — single source for vector icons ──────────────────────────────────
// Each export wraps an SVG file with theme-tinted colorize. Default size 16px,
// default color Palette.text-secondary. Override via `size` and `color` props.
//
// Usage:
//   FIconSettings { color: Palette.muted; size: 18px; }
//   FIconCheck { color: Palette.green; size: 14px; }
//
// Adding a new icon: drop the SVG into ui/icons/ then add a wrapper here.

export component FIconSettings inherits Image {
    in property <length> size: 16px;
    in property <color>  color: Palette.text-secondary;
    width: size; height: size;
    source: @image-url("../icons/settings.svg");
    colorize: color;
    image-fit: contain;
}

export component FIconX inherits Image {
    in property <length> size: 14px;
    in property <color>  color: Palette.text-secondary;
    width: size; height: size;
    source: @image-url("../icons/x.svg");
    colorize: color;
