import { Palette, Sizes, Fonts } from "../theme.slint";

// ── Single sidebar nav row ──────────────────────────────────────────────────
component SidebarItem inherits Rectangle {
    in property <int>    num;
    in property <string> label;
    in property <string> sublabel;
    in property <bool>   done: false;
    in property <bool>   current: false;
    in property <bool>   clickable: false;
    in property <bool>   locked: false;
    callback clicked();

    height: 56px;
    background: current ? Palette.chrome-active
              : ta.has-hover && clickable ? Palette.chrome-hover
              : transparent;
    animate background { duration: 120ms; }

    // Left active-rail accent (4px) — Datadog/Grafana convention
    Rectangle {
        x: 0;
        y: 0;
        width: 3px;
        height: parent.height;
        background: current ? Palette.accent : transparent;
        animate background { duration: 120ms; }
    }

    HorizontalLayout {
        padding-left: Sizes.space-4;
        padding-right: Sizes.space-3;
        spacing: Sizes.space-3;
        alignment: start;

        // Step badge — vector check when done, number when current/pending
        Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 13px;
            y: (parent.height - self.height) / 2;
            background: done ? Palette.green
                      : current ? Palette.accent
                      : Palette.elevated;
            border-width: done || current ? 0px : 1px;
            border-color: Palette.border;
            animate background { duration: 200ms; }

            if done: Image {
                source: @image-url("../icons/check.svg");
                width: 14px;
                height: 14px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                colorize: Palette.on-accent;
                image-fit: contain;
            }
            if !done: Text {
                text: num;
                font-size: Sizes.font-xs;
                font-weight: 700;
                color: current ? Palette.on-accent : Palette.muted;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 1px;

            Text {
                text: label;
                font-size: Sizes.font-md;
                font-weight: current ? 600 : 500;
                color: done ? Palette.text
                     : current ? Palette.text
                     : clickable ? Palette.text-secondary
                     : Palette.muted;
                animate color { duration: 200ms; }
            }
            Text {
                text: sublabel;
                font-size: Sizes.font-2xs;
                color: current ? Palette.text-secondary : Palette.subtle;
            }
        }
    }

    ta := TouchArea {
        enabled: clickable && !locked;
        mouse-cursor: clickable && !locked ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.clicked(); }
    }
}

// ── Section heading inside sidebar ──────────────────────────────────────────
component SidebarSection inherits Rectangle {
    in property <string> label;

    height: 32px;
    HorizontalLayout {
        padding-left: Sizes.space-4;
        padding-right: Sizes.space-3;
        alignment: start;
        Text {
            text: label;
            font-size: Sizes.font-2xs;
            font-weight: 700;
            color: Palette.subtle;
            letter-spacing: 1.2px;
            vertical-alignment: center;
        }
    }
}

// ── Wordmark + tagline shown at top of sidebar ──────────────────────────────
component SidebarBrand inherits Rectangle {
    height: 64px;
    background: Palette.chrome;

    HorizontalLayout {
        padding-left: Sizes.space-4;
        padding-right: Sizes.space-3;
        spacing: Sizes.space-3;
        alignment: start;

        // Brand mark — bold "F" monogram, no emoji
        Rectangle {
            width: 28px;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: Palette.accent;
            Text {
                text: "F";
                font-size: 18px;
                font-weight: 800;
                color: Palette.on-accent;
                vertical-alignment: center;
                horizontal-alignment: center;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0;
            Text {
                text: "ForgeISO";
                font-size: Sizes.font-lg;
                font-weight: 700;
                color: Palette.text;
                letter-spacing: -0.2px;
            }
            Text {
                text: "Linux ISO Builder";
                font-size: Sizes.font-2xs;
                font-weight: 500;
                color: Palette.muted;
                letter-spacing: 0.6px;
            }
        }
    }

    // Bottom border separates brand from nav
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Palette.chrome-border;
    }
}

// ── Sidebar — vertical step nav, GitHub/Datadog style ──────────────────────
export component Sidebar inherits Rectangle {
    in property <int>  current-step: 1;
    in property <bool> step1-done: false;
    in property <bool> step2-done: false;
    in property <bool> step3-done: false;
    in property <bool> step4-done: false;
    in property <bool> job-running: false;
    callback step-clicked(int);

    width: Sizes.sidebar-width;
    background: Palette.chrome;

    // Right border separates from main content
    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: parent.height;
        background: Palette.chrome-border;
    }

    VerticalLayout {
        alignment: start;
        spacing: 0;

        SidebarBrand {}

        SidebarSection { label: "BUILD STAGES"; }

        SidebarItem {
            num: 1; label: "Choose ISO"; sublabel: "Source image";
            done: step1-done; current: current-step == 1;
            clickable: !job-running && current-step != 1;
            locked: job-running && current-step != 1;
            clicked => { step-clicked(1); }
        }
        SidebarItem {
            num: 2; label: "Configure"; sublabel: "Installer settings";
            done: step2-done; current: current-step == 2;
            clickable: !job-running && step1-done && current-step != 2;
            locked: job-running && current-step != 2;
            clicked => { step-clicked(2); }
        }
        SidebarItem {
            num: 3; label: "Build"; sublabel: "Review and create";
            done: step3-done; current: current-step == 3;
            clickable: !job-running && step2-done && current-step != 3;
            locked: job-running && current-step != 3;
            clicked => { step-clicked(3); }
        }
        SidebarItem {
            num: 4; label: "Verify"; sublabel: "Optional checks";
            done: step4-done; current: current-step == 4;
            clickable: !job-running && step3-done && current-step != 4;
            locked: job-running && current-step != 4;
            clicked => { step-clicked(4); }
        }
    }
}
